{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "src"
  ],
  /* AJOUTEZ CE BLOC EN BAS DE VOTRE FICHIER */
  "exclude": [
    "node_modules",
    "../node_modules"
  ]
}